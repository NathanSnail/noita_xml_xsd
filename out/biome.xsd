									<!-- VegetationComponent Docs --><xsd:annotation><xsd:documentation><![CDATA[<br>```cpp<br>class VegetationComponent {<br>&emsp;&emsp;&emsp;&emsp;bool _enabled = 1; //  Generic component flag accepted on biome components; its effect here was not traced<br>&emsp;&emsp;&emsp;&emsp;bool is_visual = 0;<br>&emsp;&emsp;&emsp;&emsp;bool is_real_pixels = 0;<br>&emsp;&emsp;&emsp;&emsp;bool is_grass = 0;<br>&emsp;&emsp;&emsp;&emsp;bool is_ceiling_plant = 0;<br>&emsp;&emsp;&emsp;&emsp;bool check_safety = 0; //  if set, will check the 4 corners for safty<br>&emsp;&emsp;&emsp;&emsp;float rand_seed = 1234.0; //  uses this to randomize the positions<br>&emsp;&emsp;&emsp;&emsp;float tree_width = 120.0;<br>&emsp;&emsp;&emsp;&emsp;float tree_radius_low = 0.3;<br>&emsp;&emsp;&emsp;&emsp;float tree_radius_high = 0.7; //  within the tree width what's the max distance (1) all the way to right<br>&emsp;&emsp;&emsp;&emsp;float tree_probability = 0.7; //  what's the probability of a tree being spawned in a tree_width section<br>&emsp;&emsp;&emsp;&emsp;bool is_rare = 0; //  if true, the tree is spawned only 1/3 of cases<br>&emsp;&emsp;&emsp;&emsp;int tree_extra_y = 2; //  if is_visual is true, then this will move it down by this much (range 0..50)<br>&emsp;&emsp;&emsp;&emsp;std::string tree_image_file = "";<br>&emsp;&emsp;&emsp;&emsp;std::string tree_image_visual = "";<br>&emsp;&emsp;&emsp;&emsp;std::string tree_material = "wood";<br>&emsp;&emsp;&emsp;&emsp;std::string load_this_xml_instead = "";<br>&emsp;&emsp;&emsp;&emsp;float visual_offset_x = 0.0;<br>&emsp;&emsp;&emsp;&emsp;float visual_offset_y = 0.0;<br>&emsp;&emsp;&emsp;&emsp;std::string visual_color = "0xFFFFFF"; //  is_visual=1, the color of the single cell that is created for the plant<br>&emsp;&emsp;&emsp;&emsp;bool grass_requires_neighbors = 0;<br>&emsp;&emsp;&emsp;&emsp;std::string material_on_top_of = "";<br>&emsp;&emsp;&emsp;&emsp;bool height_check = 0; //  if != 0 will check that there is air up to this height<br>&emsp;&emsp;&emsp;&emsp;float max_y = 99999; //  this is the max y that the plant / tree can be placed<br>&emsp;&emsp;&emsp;&emsp;bool random_flip_x_scale = 0; //  if true, has 50% chance of being flipped horizontally<br>};<br>```<br>]]></xsd:documentation></xsd:annotation><!-- VegetationComponent Docs -->
