<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<!--Builtin-->
	<xsd:simpleType name="NoitaBool">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="0" />
			<xsd:enumeration value="1" />
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="BIOME_TYPE">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="BIOME_PROCEDURAL" />
			<xsd:enumeration value="BIOME_BITMAP" />
			<xsd:enumeration value="BIOME_WANG_TILE" />
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="FOG_OF_WAR_TYPE">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="DEFAULT" />
			<xsd:enumeration value="HEAVY_CLEAR_AT_PLAYER" />
			<xsd:enumeration value="HEAVY_CLEAR_WITH_MAGIC" />
			<xsd:enumeration value="HEAVY_NO_CLEAR" />
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="NOISE_TYPE">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="IQ2_SIMPLEX1234" />
			<xsd:enumeration value="IQ_SIMPLEX" />
			<xsd:enumeration value="SIN_CAPPED_EVERYTHING" />
			<xsd:enumeration value="SIN_CAPPED_SIMPLEX" />
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="GENERAL_NOISE">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="IQNoise" />
			<xsd:enumeration value="DirtyPeeNoise" />
			<xsd:enumeration value="QemNoise" />
			<xsd:enumeration value="WhiteNoise" />
			<xsd:enumeration value="MixNoise" />
			<xsd:enumeration value="SimplexNoise" />
			<xsd:enumeration value="STB_Perlin" />
			<xsd:enumeration value="FastBlockNoise" />
			<xsd:enumeration value="SimplexNoise1234" />
		</xsd:restriction>
	</xsd:simpleType>
	<!--Builtin-->
	<xsd:element name="Biome">
		<xsd:complexType mixed="true">
			<xsd:annotation>
				<xsd:documentation><![CDATA[A biome file. The game reads exactly two children: `<Topology>` (shape, background, audio) and `<Materials>` (what fills it). Anything else is ignored.]]></xsd:documentation>
			</xsd:annotation>
			<xsd:all>
				<xsd:element name="Topology" minOccurs="0">
					<xsd:complexType mixed="true">
						<!-- Topology Docs --><xsd:annotation><xsd:documentation><![CDATA[<br>```cpp<br>class Biome {<br>&emsp;&emsp;&emsp;&emsp;std::string name = ""; //  the name that is exposed to lua functions that spawn entities. Usually a $biome_ translation key<br>&emsp;&emsp;&emsp;&emsp;BIOME_TYPE::Enum type = BIOME_PROCEDURAL; //  Generator: BIOME_PROCEDURAL (cave noise), BIOME_BITMAP (bitmap_filename), BIOME_WANG_TILE (wang_template_file)<br>&emsp;&emsp;&emsp;&emsp;std::string background_image = ""; //  path to the image file (texture) that is used for the background<br>&emsp;&emsp;&emsp;&emsp;std::string background_edge_left = ""; //  if not empty, will use this image as the left edge<br>&emsp;&emsp;&emsp;&emsp;std::string background_edge_right = ""; //  if not empty, will use this image as the right edge<br>&emsp;&emsp;&emsp;&emsp;std::string background_edge_top = ""; //  if not empty, will use this image as the top edge<br>&emsp;&emsp;&emsp;&emsp;std::string background_edge_bottom = ""; //  if not empty, will use this image as the bottom edge<br>&emsp;&emsp;&emsp;&emsp;int background_edge_priority = 0; //  if both biomes have edges defined, will use the one with higher priority (if priority is same, will compare (>) background_images)<br>&emsp;&emsp;&emsp;&emsp;bool background_use_neighbor = 0; //  if set will look for neighboring biomes and use their background image<br>&emsp;&emsp;&emsp;&emsp;float background_image_height = 225.0; //  height were the background image starts<br>&emsp;&emsp;&emsp;&emsp;bool limit_background_image = 1; //  Will limit the background image to start at the cave height<br>&emsp;&emsp;&emsp;&emsp;std::string bitmap_noise_file = ""; //  if set, loads it to mBitmapNoise<br>&emsp;&emsp;&emsp;&emsp;bool noise_biome_edges = 1; //  does the noisy edge for biomes, if either of biomes has this set to 0 will do a straight edge<br>&emsp;&emsp;&emsp;&emsp;bool big_noise_biome_edges = 1; //  if true, will leak onto other biomes and not be carveable<br>&emsp;&emsp;&emsp;&emsp;bool fat_biome_edges = 0; //  if true, will leak onto other biomes and not be carveable<br>&emsp;&emsp;&emsp;&emsp;bool skip_edge_textures = 0; //  skips edge texture generation. Turn of for pixel scenes<br>&emsp;&emsp;&emsp;&emsp;std::string audio_music_enter = ""; //  the music event that plays when player enters this biome (e.g. 'music/desert/enter')<br>&emsp;&emsp;&emsp;&emsp;std::string audio_music_2 = ""; //  the music directory that plays while player is in this biome (e.g 'coalmine')<br>&emsp;&emsp;&emsp;&emsp;float audio_music_energy_coeff = 1.0; //  Multiplier for music energy in this biome<br>&emsp;&emsp;&emsp;&emsp;bool audio_music_no_forced_quietness = 0; //  If 1, music is not quieted by occasional quietness<br>&emsp;&emsp;&emsp;&emsp;int audio_music_forced_quietness_duration_seconds = 0; //  If > 0, this is the duration of occasional quietness, else the value from magic numbers is used.<br>&emsp;&emsp;&emsp;&emsp;bool audio_music_trigger_without_danger = 0; //  If 1, music is triggered in this biome no matter what the danger level is<br>&emsp;&emsp;&emsp;&emsp;int audio_music_trigger_min_y = 0;<br>&emsp;&emsp;&emsp;&emsp;int audio_music_trigger_max_y = 0;<br>&emsp;&emsp;&emsp;&emsp;std::string audio_biome_id_for_music = "";<br>&emsp;&emsp;&emsp;&emsp;std::string audio_ambience = "cave"; //  the ambience event that plays while player is in this biome<br>&emsp;&emsp;&emsp;&emsp;std::string audio_ambience_surface = "hills"; //  the ambience event that plays while player is in this biome and on surface<br>&emsp;&emsp;&emsp;&emsp;float color_grading_r = 1.0; //  post fx color grading<br>&emsp;&emsp;&emsp;&emsp;float color_grading_g = 1.0; //  post fx color grading<br>&emsp;&emsp;&emsp;&emsp;float color_grading_b = 1.0; //  post fx color grading<br>&emsp;&emsp;&emsp;&emsp;float color_grading_grayscale = 0.0; //  post fx color grading. [0.0,1.0], larger value means more grayscale<br>&emsp;&emsp;&emsp;&emsp;bool has_rain = 1; //  if 1, rain or snowfall may occur in this biome<br>&emsp;&emsp;&emsp;&emsp;FOG_OF_WAR_TYPE::Enum fog_of_war_type = DEFAULT; //  the way removing fog of war works in this biome<br>&emsp;&emsp;&emsp;&emsp;float gradient_sky_alpha_target_mod = 0.0;<br>&emsp;&emsp;&emsp;&emsp;float rain_target_mod = 0.0;<br>&emsp;&emsp;&emsp;&emsp;float fog_target_mod = 0.0;<br>&emsp;&emsp;&emsp;&emsp;float sunset_alpha_target = 1.0; //  affects sunset gradient amount<br>&emsp;&emsp;&emsp;&emsp;std::string bitmap_filename = ""; //  loads the chunk from this bitmap, the bitmap should be 512x512<br>&emsp;&emsp;&emsp;&emsp;std::string wang_template_file = ""; //  uses this file to create a herringbone wang map<br>&emsp;&emsp;&emsp;&emsp;int wang_map_width = 256; //  the size of the wang map (range 1..512)<br>&emsp;&emsp;&emsp;&emsp;int wang_map_height = 256; //  the size of the wang map (range 1..512)<br>&emsp;&emsp;&emsp;&emsp;std::string lua_script = ""; //  default is data/scripts/biomes/NAME.lua<br>&emsp;&emsp;&emsp;&emsp;bool pixel_scene = 0; //  for 'pixel scene' biomes, this forces the loading before hand<br>&emsp;&emsp;&emsp;&emsp;bool static_tile = 0; //  if 1, directly blits wang_template_file without wang randomization, kind of like a pixel scene but at the wang tile resolution<br>&emsp;&emsp;&emsp;&emsp;std::string static_tile_bg_mask = ""; //  if set, and static tile is 1, the background_image will use a special shader and this mask to calculate visiblity. should be same size and resolution as 'wang_template_file'<br>&emsp;&emsp;&emsp;&emsp;float static_tile_bg_mask_threshold = 0.5; //  threshold used in 'sprite_static_tile_bg.frag' shader in conjuction with 'sprite_static_tile_bg_mask' to determine if a background pixel is visible or not<br>&emsp;&emsp;&emsp;&emsp;float game_enemy_hp_scale = 1.0; //  1.f = default. Will multiply the hp of the camerabounded enemies in the area with hp_scale<br>&emsp;&emsp;&emsp;&emsp;float game_enemy_attack_speed = 1.0; //  1.f = default. This multiplies AnimalAI's attack_ranged_frames_between in camerabounded enemies<br>&emsp;&emsp;&emsp;&emsp;NOISE_TYPE::Enum noise_type = IQ2_SIMPLEX1234; //  the style of the cave noise<br>&emsp;&emsp;&emsp;&emsp;GENERAL_NOISE::Enum mInsideNoiseType = SimplexNoise; //  the style of the inside noise<br>&emsp;&emsp;&emsp;&emsp;bool mInsideNoiseFBM = 1; //  will fbm the mInsideNoise if set true<br>&emsp;&emsp;&emsp;&emsp;double mInsidePerlinScaleX = 1.0; //  the noise inside the stones...<br>&emsp;&emsp;&emsp;&emsp;double mInsidePerlinScaleY = 1.0; //  the noise inside the stones...<br>&emsp;&emsp;&emsp;&emsp;bool mInsidePerlinSquared = 0;<br>&emsp;&emsp;&emsp;&emsp;bool mInsidePerlinClamped = 0;<br>&emsp;&emsp;&emsp;&emsp;bool mInsidePerlinScaled = 0;<br>&emsp;&emsp;&emsp;&emsp;float mInsidePerlinScaleMin = 0.0;<br>&emsp;&emsp;&emsp;&emsp;float mInsidePerlinScaleMax = 0.0;<br>&emsp;&emsp;&emsp;&emsp;bool mInsidePerlinForceInside = 0; //  if set, will multiply the noise_value with the gradient value<br>&emsp;&emsp;&emsp;&emsp;bool mInsidePerlinOffsetBySeed = 0; //  NOTE( Petri ): 17.8.2023 - if set, will add worldseed as an offset to the noise<br>&emsp;&emsp;&emsp;&emsp;double mInsidePerlinOffsetX = 0.0; //  NOTE( Petri ): 17.8.2023 - perlin noise offset<br>&emsp;&emsp;&emsp;&emsp;double mInsidePerlinOffsetY = 0.0; //  NOTE( Petri ): 17.8.2023 - perlin noise offset<br>&emsp;&emsp;&emsp;&emsp;float mInsideAddValue = 0.0; //  added inside the caves the gradient value<br>&emsp;&emsp;&emsp;&emsp;float mMultiplierGradient = 1.0; //  how much of the gradient is applied<br>&emsp;&emsp;&emsp;&emsp;float mMultiplierPerlin = 1.0; //  how much of the inside noise<br>&emsp;&emsp;&emsp;&emsp;float mMultiplierExtraPerlin = 1.0;<br>&emsp;&emsp;&emsp;&emsp;float mGradientStartY = -512.0;<br>&emsp;&emsp;&emsp;&emsp;float mGradientEndY = 512.0;<br>&emsp;&emsp;&emsp;&emsp;double mGradientSlopeStartX = 0.0; //  if addNoise = 3, will use this to the ( x - mGradientSlopeStartX ) * mGradientSlopeDelta<br>&emsp;&emsp;&emsp;&emsp;double mGradientSlopeDelta = 1.0; //  if addNoise = 3, will use this to the ( x - mGradientSlopeStartX ) * mGradientSlopeDelta<br>&emsp;&emsp;&emsp;&emsp;int mGradientAddNoise = 1; //  fake enum 1=standard noise, 2=fbm noise, 3=slope<br>&emsp;&emsp;&emsp;&emsp;double mGradientNoiseScale = 0.01;<br>&emsp;&emsp;&emsp;&emsp;float mGradientLowNoise = -100.0;<br>&emsp;&emsp;&emsp;&emsp;float mGradientHighNoise = 100.0;<br>&emsp;&emsp;&emsp;&emsp;bool coarse_map_force_terrain = 0; //  if 1, is initially marked as 'terrain' in the coarse map used for sky light calculations etc<br>&emsp;&emsp;&emsp;&emsp;bool coarse_map_not_terrain = 0; //  if 1, is initially never marked as 'terrain' in the coarse map used for sky light calculations etc<br>&emsp;&emsp;&emsp;&emsp;bool coarse_map_cell_count_always_zero = 0; //  if 1, areas in this biome always have a 64x64 cell count of 0<br>&emsp;&emsp;&emsp;&emsp;bool coarse_map_inject_light = 0;<br>};<br>```<br>]]></xsd:documentation></xsd:annotation><!-- Topology Docs -->
						<xsd:all>
							<xsd:element name="BitmapCaves" minOccurs="0">
								<xsd:complexType mixed="true">
									<!-- BitmapCaves Docs --><xsd:annotation><xsd:documentation><![CDATA[<br>```cpp<br>class CavesSetup {<br>&emsp;&emsp;&emsp;&emsp;std::string name = ""; //  we share these based on the names, so make them unique<br>&emsp;&emsp;&emsp;&emsp;int size_x = 512; //  How big the image is that we generate these from<br>&emsp;&emsp;&emsp;&emsp;int size_y = 256; //  How big the image is that we generate these from<br>&emsp;&emsp;&emsp;&emsp;float spawn_percent = 0.05; //  0-1 - with what chance do we add a spawn point to a cave<br>&emsp;&emsp;&emsp;&emsp;int cave_count_min = 50; //  generates caves n, where n = random(cave_count_min, cave_count_max) (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;int cave_count_max = 100; //  generates caves n, where n = random(cave_count_min, cave_count_max) (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;bool do_beginning_paths = 0; //  if set, will do the paths that go down near the center of the image, used for setting up the caves to coal mines near where player starts<br>&emsp;&emsp;&emsp;&emsp;bool do_beginning_down = 0; //  if true, will do a hole straight down<br>&emsp;&emsp;&emsp;&emsp;int surface_caves_count_min = 7; //  generates caves n from the surface, where n = random(surface_caves_count_min, surface_caves_count_max) (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;int surface_caves_count_max = 12; //  generates caves n from the surface, where n = random(surface_caves_count_min, surface_caves_count_max) (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;float cave_strength_min = 0.2; //  how strongly do we carve the cave<br>&emsp;&emsp;&emsp;&emsp;float cave_strength_max = 1.0; //  how strongly do we carve the cave<br>&emsp;&emsp;&emsp;&emsp;int cave_childs_min = 0; //  how many child trails a cave can have (range 0..10)<br>&emsp;&emsp;&emsp;&emsp;int cave_childs_max = 2; //  how many child trails a cave can have (range 0..10)<br>&emsp;&emsp;&emsp;&emsp;int surface_cave_childs_min = 2; //  how many child trails a cave can have (range 0..10)<br>&emsp;&emsp;&emsp;&emsp;int surface_cave_childs_max = 7; //  how many child trails a cave can have (range 0..10)<br>&emsp;&emsp;&emsp;&emsp;int mountain_count_min = 0; //  how many child trails a cave can have (range 0..10)<br>&emsp;&emsp;&emsp;&emsp;int mountain_count_max = 15; //  how many child trails a cave can have (range 0..10)<br>&emsp;&emsp;&emsp;&emsp;float mountain_size_min = 1.0;<br>&emsp;&emsp;&emsp;&emsp;float mountain_size_max = 10.0;<br>&emsp;&emsp;&emsp;&emsp;int blob_caves_count_min = 20; //   (range 0..50)<br>&emsp;&emsp;&emsp;&emsp;int blob_caves_count_max = 55; //   (range 0..100)<br>&emsp;&emsp;&emsp;&emsp;float blob_caves_strength_min = 1.5; //   (range 0..50)<br>&emsp;&emsp;&emsp;&emsp;float blob_caves_strength_max = 3.0; //   (range 0..100)<br>&emsp;&emsp;&emsp;&emsp;float blob_caves_radius_min = 1.0;<br>&emsp;&emsp;&emsp;&emsp;float blob_caves_radius_max = 10.0;<br>&emsp;&emsp;&emsp;&emsp;std::string DEBUG_output_image = ""; //  if set, will save a png of the height map to the file specified here<br>};<br>```<br>]]></xsd:documentation></xsd:annotation><!-- BitmapCaves Docs -->
									<xsd:all>
										<xsd:element name="structures" minOccurs="0">
											<xsd:complexType mixed="true">
												<xsd:sequence>
													<xsd:element name="CaveStructure" minOccurs="0" maxOccurs="unbounded">
														<xsd:complexType mixed="true">
															<!-- CaveStructure Docs --><xsd:annotation><xsd:documentation><![CDATA[<br>```cpp<br>class CaveStructure {<br>&emsp;&emsp;&emsp;&emsp;std::string image_file = ""; //  path to image file that's going to be blitted<br>&emsp;&emsp;&emsp;&emsp;int count_min = 50; //   (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;int count_max = 100; //   (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;int aabb_min_x = 50; //   (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;int aabb_min_y = 100; //   (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;int aabb_max_x = 50; //   (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;int aabb_max_y = 100; //   (range 0..200)<br>&emsp;&emsp;&emsp;&emsp;float strength_min = 1.5;<br>&emsp;&emsp;&emsp;&emsp;float strength_max = 1.5;<br>};<br>```<br>]]></xsd:documentation></xsd:annotation><!-- CaveStructure Docs -->
															<!-- CaveStructure Attributes -->
		<xsd:attribute name="image_file" type="xsd:string" default="">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>std::string image_file = ""; //  path to image file that's going to be blitted<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="count_min" type="xsd:int" default="50">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int count_min = 50; //   (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="count_max" type="xsd:int" default="100">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int count_max = 100; //   (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="aabb_min_x" type="xsd:int" default="50">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int aabb_min_x = 50; //   (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="aabb_min_y" type="xsd:int" default="100">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int aabb_min_y = 100; //   (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="aabb_max_x" type="xsd:int" default="50">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int aabb_max_x = 50; //   (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="aabb_max_y" type="xsd:int" default="100">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int aabb_max_y = 100; //   (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="strength_min" type="xsd:decimal" default="1.5">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>float strength_min = 1.5;<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="strength_max" type="xsd:decimal" default="1.5">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>float strength_max = 1.5;<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
<!-- CaveStructure Attributes -->
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
									</xsd:all>
									<!-- BitmapCaves Attributes -->
		<xsd:attribute name="name" type="xsd:string" default="">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>std::string name = ""; //  we share these based on the names, so make them unique<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="size_x" type="xsd:int" default="512">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int size_x = 512; //  How big the image is that we generate these from<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="size_y" type="xsd:int" default="256">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int size_y = 256; //  How big the image is that we generate these from<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="spawn_percent" type="xsd:decimal" default="0.05">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>float spawn_percent = 0.05; //  0-1 - with what chance do we add a spawn point to a cave<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="cave_count_min" type="xsd:int" default="50">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int cave_count_min = 50; //  generates caves n, where n = random(cave_count_min, cave_count_max) (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="cave_count_max" type="xsd:int" default="100">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int cave_count_max = 100; //  generates caves n, where n = random(cave_count_min, cave_count_max) (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="do_beginning_paths" type="NoitaBool" default="0">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>bool do_beginning_paths = 0; //  if set, will do the paths that go down near the center of the image, used for setting up the caves to coal mines near where player starts<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="do_beginning_down" type="NoitaBool" default="0">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>bool do_beginning_down = 0; //  if true, will do a hole straight down<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="surface_caves_count_min" type="xsd:int" default="7">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int surface_caves_count_min = 7; //  generates caves n from the surface, where n = random(surface_caves_count_min, surface_caves_count_max) (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="surface_caves_count_max" type="xsd:int" default="12">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int surface_caves_count_max = 12; //  generates caves n from the surface, where n = random(surface_caves_count_min, surface_caves_count_max) (range 0..200)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="cave_strength_min" type="xsd:decimal" default="0.2">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>float cave_strength_min = 0.2; //  how strongly do we carve the cave<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="cave_strength_max" type="xsd:decimal" default="1.0">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>float cave_strength_max = 1.0; //  how strongly do we carve the cave<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="cave_childs_min" type="xsd:int" default="0">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int cave_childs_min = 0; //  how many child trails a cave can have (range 0..10)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="cave_childs_max" type="xsd:int" default="2">
			<xsd:annotation>
				<xsd:documentation><![CDATA[```cpp<br>int cave_childs_max = 2; //  how many child trails a cave can have (range 0..10)<br>```]]></xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
